# Choix du fournisseur LLM : "ollama" (local) ou "opencode" (API cloud)
LLM_PROVIDER=ollama

# --- Configuration Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# --- Configuration OpenCode Go/Zen (LLM_PROVIDER=opencode) ---
# Obtenez votre cle API sur https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
# Pour Go : https://opencode.ai/zen/go/v1
# Pour Zen : https://opencode.ai/zen/v1
OPENCODE_API_URL=https://opencode.ai/zen/go/v1
# Nombre maximum de tokens de reponse
OPENCODE_MAX_TOKENS=4096
# Temperature du modele (0.0 - 2.0)
OPENCODE_TEMPERATURE=0.6

# Timeout d'inactivite en ms (laisser vide pour desactiver)
OLLAMA_TIMEOUT=60000
